<UserControl x:Class="BloodBankPro.Views.DonorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded" Background="#F9F9F9">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#FFFFFF" Padding="24,16" BorderBrush="#E0E4E8" BorderThickness="0,0,0,1">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="1" BlurRadius="6" Opacity="0.04" Color="Black"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{DynamicResource Page_Donors}" Style="{StaticResource PageHeader}"/>
                    <TextBlock Text="Register and track blood donors with eligibility monitoring" Style="{StaticResource PageSub}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="📤 Export CSV" Style="{StaticResource IconBtn}" Margin="0,0,8,0" Click="BtnExport_Click"/>
                    <Button Content="+ Add Donor" Style="{StaticResource PrimaryBtn}" Click="BtnAdd_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,12">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="1" BlurRadius="6" Opacity="0.04" Color="Black"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔍" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#5A6A7A"/>
                    <TextBox x:Name="TxtSearch" Height="34" Width="220" Padding="8,6" FontSize="13"
                             Background="#FFFFFF" Foreground="#1A1A2E" BorderBrush="#D5D8DC" BorderThickness="1"
                             CaretBrush="#8B0000" Margin="0,0,10,0" TextChanged="OnFilter"/>
                    <ComboBox x:Name="CmbBlood" Style="{StaticResource FCB}" Height="34" Width="110" Margin="0,0,10,0" SelectionChanged="OnFilter">
                        <ComboBoxItem Content="All Types" IsSelected="True"/>
                        <ComboBoxItem Content="A+"/><ComboBoxItem Content="A-"/><ComboBoxItem Content="B+"/><ComboBoxItem Content="B-"/>
                        <ComboBoxItem Content="AB+"/><ComboBoxItem Content="AB-"/><ComboBoxItem Content="O+"/><ComboBoxItem Content="O-"/>
                    </ComboBox>
                    <ComboBox x:Name="CmbStatus" Style="{StaticResource FCB}" Height="34" Width="120" SelectionChanged="OnFilter">
                        <ComboBoxItem Content="All Status" IsSelected="True"/>
                        <ComboBoxItem Content="Active"/><ComboBoxItem Content="Inactive"/>
                    </ComboBox>
                    <TextBlock x:Name="TxtCount" Text="" FontSize="12" Foreground="#8795A5" VerticalAlignment="Center" Margin="16,0,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Row="1" Style="{StaticResource Card}">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" BlurRadius="10" Opacity="0.06" Color="Black"/>
                </Border.Effect>
                <DataGrid x:Name="DgDonors" Style="{StaticResource DarkGrid}"
                          RowStyle="{StaticResource DarkRow}" CellStyle="{StaticResource DarkCell}">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F6F8FA"/>
                            <Setter Property="Foreground" Value="#8B0000"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontFamily" Value="Segoe UI"/>
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="BorderBrush" Value="#E0E4E8"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID"         Binding="{Binding Id}"                  Width="45"/>
                        <DataGridTextColumn Header="Full Name"  Binding="{Binding FullName}"            Width="160"/>
                        <DataGridTextColumn Header="Blood Type" Binding="{Binding BloodType}"           Width="90"/>
                        <DataGridTextColumn Header="Age"        Binding="{Binding Age}"                 Width="50"/>
                        <DataGridTextColumn Header="Gender"     Binding="{Binding Gender}"              Width="75"/>
                        <DataGridTemplateColumn Header="Phone" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="4,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayPhone}" VerticalAlignment="Center"/>
                                        <Button Content="👁️" 
                                                Command="{Binding DataContext.RevealPhoneCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent" BorderThickness="0" 
                                                Margin="6,0,0,0" Padding="0" Cursor="Hand"
                                                ToolTip="Reveal Phone Number">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPhoneRevealed}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Weight(kg)" Binding="{Binding Weight}"              Width="90"/>
                        <DataGridTextColumn Header="Donations"  Binding="{Binding TotalDonations}"      Width="80"/>
                        <DataGridTextColumn Header="Last Donated" Binding="{Binding LastDonationDisplay}" Width="110"/>
                        <DataGridTemplateColumn Header="Eligibility" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="6,2" Margin="4,4">
                                        <Border.Background><Binding Path="EligibilityColor"/></Border.Background>
                                        <TextBlock Text="{Binding EligibilityStatus}" Foreground="White"
                                                   FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Status"     Binding="{Binding Status}"              Width="80"/>
                        <DataGridTemplateColumn Header="Edit" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="4,2">
                                        <Button Content="Edit" Style="{StaticResource EditBtn}" Click="BtnEdit_Click" Tag="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn x:Name="ColDonorDelete" Header="Delete" Width="75">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="4,2">
                                        <Button Content="Delete" Style="{StaticResource DelBtn}" Click="BtnDelete_Click" Tag="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
        <Grid x:Name="Overlay" Grid.RowSpan="2" Visibility="Collapsed" Background="#88000000">
            <Border Background="#FFFFFF" Width="520" CornerRadius="14" VerticalAlignment="Center"
                    BorderBrush="#8B000030" BorderThickness="1" MaxHeight="660">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="4" BlurRadius="20" Opacity="0.15" Color="Black"/>
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="34,28">
                        <TextBlock x:Name="FrmTitle" Text="Add New Donor" FontSize="18" FontWeight="Bold"
                                   FontFamily="Segoe UI Semibold"
                                   Foreground="#8B0000" Margin="0,0,0,20"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="FULL NAME *" Style="{StaticResource FL}"/>
                                <TextBox x:Name="FName" Style="{StaticResource FTB}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="BLOOD TYPE *" Style="{StaticResource FL}"/>
                                <ComboBox x:Name="FBlood" Style="{StaticResource FCB}">
                                    <ComboBoxItem Content="A+"/><ComboBoxItem Content="A-"/><ComboBoxItem Content="B+"/><ComboBoxItem Content="B-"/>
                                    <ComboBoxItem Content="AB+"/><ComboBoxItem Content="AB-"/><ComboBoxItem Content="O+"/><ComboBoxItem Content="O-"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="AGE *" Style="{StaticResource FL}"/>
                                <TextBox x:Name="FAge" Style="{StaticResource FTB}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="GENDER" Style="{StaticResource FL}"/>
                                <ComboBox x:Name="FGender" Style="{StaticResource FCB}">
                                    <ComboBoxItem Content="Male"/><ComboBoxItem Content="Female"/><ComboBoxItem Content="Other"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="WEIGHT (KG)" Style="{StaticResource FL}"/>
                                <TextBox x:Name="FWeight" Style="{StaticResource FTB}"/>
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="PHONE" Style="{StaticResource FL}"/>
                                <TextBox x:Name="FPhone" Style="{StaticResource FTB}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="EMAIL" Style="{StaticResource FL}"/>
                                <TextBox x:Name="FEmail" Style="{StaticResource FTB}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="ADDRESS" Style="{StaticResource FL}"/>
                        <TextBox x:Name="FAddress" Style="{StaticResource FTB}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="LAST DONATION DATE" Style="{StaticResource FL}"/>
                                <DatePicker x:Name="FLastDonation" Height="40" Margin="0,0,0,12" FontSize="13"
                                            Background="#FFFFFF" Foreground="#1A1A2E"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="STATUS *" Style="{StaticResource FL}"/>
                                <ComboBox x:Name="FStatus" Style="{StaticResource FCB}">
                                    <ComboBoxItem Content="Active" IsSelected="True"/>
                                    <ComboBoxItem Content="Inactive"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="FError" Text="" Foreground="#8B0000" FontSize="12"
                                   Margin="0,0,0,10" Visibility="Collapsed" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Content="Cancel" Style="{StaticResource CancelBtn}" Margin="0,0,10,0" Click="BtnCancel_Click"/>
                            <Button Content="💾  Save Donor" Style="{StaticResource PrimaryBtn}" Click="BtnSave_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>

