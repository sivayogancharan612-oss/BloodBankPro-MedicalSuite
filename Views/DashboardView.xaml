<UserControl x:Class="BloodBankPro.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded" Background="#F9F9F9">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24">
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{DynamicResource Page_Dashboard}" Style="{StaticResource PageHeader}"/>
                    <TextBlock x:Name="TxtDate" Text="" Style="{StaticResource PageSub}"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="8" Padding="14,8"
                        BorderBrush="#E0E4E8" BorderThickness="1" VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="1" BlurRadius="6" Opacity="0.05" Color="Black"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#2E7D32" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="SQL Server LocalDB" FontSize="12" FontFamily="Segoe UI" Foreground="#5A6A7A"/>
                    </StackPanel>
                </Border>
            </Grid>
            <UniformGrid Columns="4" Margin="0,0,0,16">
                <Border Style="{StaticResource StatCard}" Margin="0,0,12,0">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="2" BlurRadius="10" Opacity="0.08" Color="Black"/>
                    </Border.Effect>
                    <Border.BorderBrush><SolidColorBrush Color="#8B0000" Opacity="0.2"/></Border.BorderBrush>
                    <StackPanel Margin="20,18">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="ACTIVE DONORS" FontSize="10" Foreground="#5A6A7A" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                <TextBlock x:Name="TxtDonors" Text="0" FontSize="34" FontWeight="Bold" Foreground="#8B0000" Margin="0,6,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#FFF0F0" Width="44" Height="44" CornerRadius="12" VerticalAlignment="Top">
                                <TextBlock Text="👤" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}" Margin="0,0,12,0">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="2" BlurRadius="10" Opacity="0.08" Color="Black"/>
                    </Border.Effect>
                    <Border.BorderBrush><SolidColorBrush Color="#00838F" Opacity="0.2"/></Border.BorderBrush>
                    <StackPanel Margin="20,18">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="BLOOD UNITS" FontSize="10" Foreground="#5A6A7A" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                <TextBlock x:Name="TxtUnits" Text="0" FontSize="34" FontWeight="Bold" Foreground="#00838F" Margin="0,6,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#E0F7FA" Width="44" Height="44" CornerRadius="12" VerticalAlignment="Top">
                                <TextBlock Text="🩸" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}" Margin="0,0,12,0">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="2" BlurRadius="10" Opacity="0.08" Color="Black"/>
                    </Border.Effect>
                    <Border.BorderBrush><SolidColorBrush Color="#E65100" Opacity="0.2"/></Border.BorderBrush>
                    <StackPanel Margin="20,18">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="PENDING REQUESTS" FontSize="10" Foreground="#5A6A7A" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                <TextBlock x:Name="TxtPending" Text="0" FontSize="34" FontWeight="Bold" Foreground="#E65100" Margin="0,6,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#FFF3E0" Width="44" Height="44" CornerRadius="12" VerticalAlignment="Top">
                                <TextBlock Text="📋" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="2" BlurRadius="10" Opacity="0.08" Color="Black"/>
                    </Border.Effect>
                    <Border.BorderBrush><SolidColorBrush Color="#C62828" Opacity="0.25"/></Border.BorderBrush>
                    <StackPanel Margin="20,18">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="CRITICAL" FontSize="10" Foreground="#5A6A7A" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                <TextBlock x:Name="TxtCritical" Text="0" FontSize="34" FontWeight="Bold" Foreground="#C62828" Margin="0,6,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#FFEBEE" Width="44" Height="44" CornerRadius="12" VerticalAlignment="Top">
                                <TextBlock Text="🚨" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </UniformGrid>
            <UniformGrid Columns="4" Margin="0,0,0,24">
                <Border Style="{StaticResource StatCard}" Margin="0,0,12,0">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="1" BlurRadius="6" Opacity="0.05" Color="Black"/>
                    </Border.Effect>
                    <StackPanel Margin="20,16">
                        <TextBlock Text="HOSPITALS" FontSize="10" Foreground="#5A6A7A" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                        <TextBlock x:Name="TxtHospitals" Text="0" FontSize="28" FontWeight="Bold" Foreground="#6A1B9A" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}" Margin="0,0,12,0">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="1" BlurRadius="6" Opacity="0.05" Color="Black"/>
                    </Border.Effect>
                    <StackPanel Margin="20,16">
                        <TextBlock Text="TOTAL DONATIONS" FontSize="10" Foreground="#5A6A7A" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                        <TextBlock x:Name="TxtDonations" Text="0" FontSize="28" FontWeight="Bold" Foreground="#2E7D32" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}" Margin="0,0,12,0">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="1" BlurRadius="6" Opacity="0.05" Color="Black"/>
                    </Border.Effect>
                    <StackPanel Margin="20,16">
                        <TextBlock Text="TODAY'S APPTS" FontSize="10" Foreground="#5A6A7A" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                        <TextBlock x:Name="TxtAppts" Text="0" FontSize="28" FontWeight="Bold" Foreground="#E65100" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="1" BlurRadius="6" Opacity="0.05" Color="Black"/>
                    </Border.Effect>
                    <StackPanel Margin="20,16">
                        <TextBlock Text="EXPIRING &lt;30D" FontSize="10" Foreground="#5A6A7A" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                        <TextBlock x:Name="TxtExpiring" Text="0" FontSize="28" FontWeight="Bold" Foreground="#C62828" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="290"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="20,18">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="2" BlurRadius="10" Opacity="0.06" Color="Black"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="🩸  Blood Stock Levels" FontSize="14" FontWeight="Bold"
                                   FontFamily="Segoe UI Semibold"
                                   Foreground="#8B0000" Margin="0,0,0,16"/>
                        <ItemsControl x:Name="StockBars">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding BloodType}"
                                                   FontWeight="Bold" FontSize="14"
                                                   Foreground="{Binding BarColor}"
                                                   VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Background="#F0F2F5" CornerRadius="99"
                                                Height="14" Margin="6,0">
                                            <Border Background="{Binding BarColor}" CornerRadius="99"
                                                    Height="14" HorizontalAlignment="Left"
                                                    Width="{Binding BarWidth}"/>
                                        </Border>
                                        <TextBlock Grid.Column="2" FontWeight="Bold" FontSize="12"
                                                   Foreground="{Binding BarColor}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <Run Text="{Binding Units, Mode=OneWay}"/>
                                            <Run Text="u" Foreground="#8795A5"/>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,14"
                            BorderBrush="#C6282830" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect ShadowDepth="2" BlurRadius="10" Opacity="0.06" Color="Black"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="⚠  Low Stock Alerts" FontSize="13" FontWeight="Bold"
                                       FontFamily="Segoe UI Semibold"
                                       Foreground="#C62828" Margin="0,0,0,10"/>
                            <ItemsControl x:Name="LowStockList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FFF5F5" CornerRadius="8"
                                                Padding="10,7" Margin="0,0,0,5"
                                                BorderBrush="#C6282820" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding BloodType}"
                                                           FontWeight="Bold" FontSize="14"
                                                           Foreground="#C62828"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <TextBlock Text="{Binding UnitsAvailable}"
                                                               FontWeight="Bold" FontSize="13"
                                                               Foreground="{Binding StockLevelColor}"/>
                                                    <TextBlock Text=" units" FontSize="11" Foreground="#8795A5" VerticalAlignment="Bottom"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="TxtNoAlerts" Text="✅ All levels sufficient"
                                       FontSize="12" Foreground="#2E7D32"
                                       Visibility="Collapsed" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="16,14"
                            BorderBrush="#E6510030" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect ShadowDepth="2" BlurRadius="10" Opacity="0.06" Color="Black"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="🚨  Critical Requests" FontSize="13" FontWeight="Bold"
                                       FontFamily="Segoe UI Semibold"
                                       Foreground="#E65100" Margin="0,0,0,10"/>
                            <DataGrid x:Name="DgCritical" Style="{StaticResource DarkGrid}"
                                      RowStyle="{StaticResource DarkRow}"
                                      CellStyle="{StaticResource DarkCell}"
                                      ColumnHeaderHeight="30" RowHeight="32" FontSize="12">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#F9F9F9"/>
                                        <Setter Property="Foreground" Value="#5A6A7A"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Padding" Value="6,0"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="FontFamily" Value="Segoe UI"/>
                                        <Setter Property="BorderBrush" Value="#E0E4E8"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Patient"   Binding="{Binding PatientName}" Width="*"/>
                                    <DataGridTextColumn Header="Blood"     Binding="{Binding BloodType}"   Width="52"/>
                                    <DataGridTextColumn Header="Units"     Binding="{Binding UnitsNeeded}" Width="44"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="TxtNoCritical" Text="✅ No critical requests"
                                       FontSize="12" Foreground="#2E7D32"
                                       Visibility="Collapsed" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <Border Grid.Column="4" Style="{StaticResource Card}" Padding="16,14">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="2" BlurRadius="10" Opacity="0.06" Color="Black"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="⚡  Recent Activity" FontSize="13" FontWeight="Bold"
                                   FontFamily="Segoe UI Semibold"
                                   Foreground="#00838F" Margin="0,0,0,12"/>
                        <ItemsControl x:Name="ActivityList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F6F8FA" CornerRadius="8"
                                            Padding="10,8" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="{Binding ActionColor}"
                                                        CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding Action}" FontSize="9"
                                                               FontWeight="Bold" Foreground="White"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding TableName}"
                                                           FontSize="11" FontWeight="SemiBold"
                                                           Foreground="#2F4F4F" VerticalAlignment="Center"/>
                                            </Grid>
                                            <TextBlock Grid.Row="1" Text="{Binding Details}"
                                                       FontSize="11" Foreground="#5A6A7A"
                                                       TextWrapping="Wrap" Margin="0,4,0,0"
                                                       MaxWidth="240"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

