<UserControl x:Class="BloodBankPro.Views.CompatibilityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F9F9F9">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24">
            <TextBlock Text="{DynamicResource Page_Compatibility}" Style="{StaticResource PageHeader}"/>
            <TextBlock Text="Find compatible donors for any patient — real-time from SQL Server" Style="{StaticResource PageSub}"/>
            <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,0,0,20">
                <Border.Effect><DropShadowEffect ShadowDepth="2" BlurRadius="10" Opacity="0.06" Color="Black"/></Border.Effect>
                <StackPanel>
                    <TextBlock Text="📊  Compatibility Reference Chart" FontSize="14" FontWeight="Bold" FontFamily="Segoe UI Semibold" Foreground="#00838F" Margin="0,0,0,16"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <Border Background="#E8F5E9" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
                                <TextBlock Text="🩸  Can DONATE to →" FontSize="13" FontWeight="Bold" Foreground="#2E7D32"/>
                            </Border>
                            <ItemsControl x:Name="DonateList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F6F8FA" CornerRadius="8" Padding="12,8" Margin="0,0,0,5"
                                                BorderBrush="#E0E4E8" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Type}" FontWeight="Bold"
                                                           FontSize="15" Foreground="#8B0000" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Info}" FontSize="12"
                                                           Foreground="#5A6A7A" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Border Background="#E0F7FA" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
                                <TextBlock Text="💉  Can RECEIVE from →" FontSize="13" FontWeight="Bold" Foreground="#00838F"/>
                            </Border>
                            <ItemsControl x:Name="ReceiveList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F6F8FA" CornerRadius="8" Padding="12,8" Margin="0,0,0,5"
                                                BorderBrush="#E0E4E8" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Type}" FontWeight="Bold"
                                                           FontSize="15" Foreground="#00838F" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Info}" FontSize="12"
                                                           Foreground="#5A6A7A" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="22,18">
                <Border.Effect><DropShadowEffect ShadowDepth="2" BlurRadius="10" Opacity="0.06" Color="Black"/></Border.Effect>
                <StackPanel>
                    <TextBlock Text="🔍  Find Compatible Donors for a Patient" FontSize="14" FontWeight="Bold" FontFamily="Segoe UI Semibold" Foreground="#2E7D32" Margin="0,0,0,16"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="Patient Blood Type:" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#1A1A2E" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <ComboBox x:Name="CmbRecipient" Style="{StaticResource FCB}" Height="36" Width="110" Margin="0,0,12,0">
                            <ComboBoxItem Content="A+"  IsSelected="True"/><ComboBoxItem Content="A-"/>
                            <ComboBoxItem Content="B+"/><ComboBoxItem Content="B-"/>
                            <ComboBoxItem Content="AB+"/><ComboBoxItem Content="AB-"/>
                            <ComboBoxItem Content="O+"/><ComboBoxItem Content="O-"/>
                        </ComboBox>
                        <Button Content="🔍  Search Compatible Donors" Style="{StaticResource PrimaryBtn}" Background="#2E7D32" Click="BtnSearch_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtResult" Text="" FontSize="13" FontWeight="SemiBold" Foreground="#2E7D32" Margin="0,0,0,10" TextWrapping="Wrap"/>
                    <DataGrid x:Name="DgCompatible" Style="{StaticResource DarkGrid}"
                              RowStyle="{StaticResource DarkRow}" CellStyle="{StaticResource DarkCell}"
                              Visibility="Collapsed">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F6F8FA"/>
                                <Setter Property="Foreground" Value="#2E7D32"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontFamily" Value="Segoe UI"/>
                                <Setter Property="Padding" Value="10,0"/>
                                <Setter Property="BorderBrush" Value="#E0E4E8"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name"          Binding="{Binding FullName}"            Width="180"/>
                            <DataGridTextColumn Header="Blood Type"    Binding="{Binding BloodType}"           Width="100"/>
                            <DataGridTextColumn Header="Phone"         Binding="{Binding Phone}"               Width="130"/>
                            <DataGridTextColumn Header="Donations"     Binding="{Binding TotalDonations}"      Width="90"/>
                            <DataGridTextColumn Header="Last Donated"  Binding="{Binding LastDonationDisplay}" Width="120"/>
                            <DataGridTemplateColumn Header="Eligibility" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="6,2" Margin="4,4" HorizontalAlignment="Left">
                                            <Border.Background><Binding Path="EligibilityColor"/></Border.Background>
                                            <TextBlock Text="{Binding EligibilityStatus}" Foreground="White"
                                                       FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Address"       Binding="{Binding Address}"             Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

