<UserControl x:Class="BloodBankPro.Views.BloodStockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:BloodBankPro.Converters"
             Loaded="OnLoaded" Background="#F9F9F9">
    <UserControl.Resources>
        <converters:StockToQrConverter x:Key="StockToQrConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#FFFFFF" Padding="24,16" BorderBrush="#E0E4E8" BorderThickness="0,0,0,1">
            <Border.Effect><DropShadowEffect ShadowDepth="1" BlurRadius="6" Opacity="0.04" Color="Black"/></Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{DynamicResource Page_BloodStock}" Style="{StaticResource PageHeader}"/>
                    <TextBlock Text="Track blood units, expiry dates and availability in real-time" Style="{StaticResource PageSub}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="📤 Export CSV" Style="{StaticResource IconBtn}" Margin="0,0,8,0" Click="BtnExport_Click"/>
                    <Button Content="+ Add Stock" Style="{StaticResource PrimaryBtn}" Click="BtnAdd_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,12">
                <Border.Effect><DropShadowEffect ShadowDepth="1" BlurRadius="6" Opacity="0.04" Color="Black"/></Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <ComboBox x:Name="CmbBlood" Style="{StaticResource FCB}" Height="34" Width="120" Margin="0,0,10,0" SelectionChanged="OnFilter">
                        <ComboBoxItem Content="All Types" IsSelected="True"/>
                        <ComboBoxItem Content="A+"/><ComboBoxItem Content="A-"/><ComboBoxItem Content="B+"/><ComboBoxItem Content="B-"/>
                        <ComboBoxItem Content="AB+"/><ComboBoxItem Content="AB-"/><ComboBoxItem Content="O+"/><ComboBoxItem Content="O-"/>
                    </ComboBox>
                    <ComboBox x:Name="CmbStatus" Style="{StaticResource FCB}" Height="34" Width="130" SelectionChanged="OnFilter">
                        <ComboBoxItem Content="All Status" IsSelected="True"/>
                        <ComboBoxItem Content="Available"/><ComboBoxItem Content="Used"/><ComboBoxItem Content="Expired"/>
                    </ComboBox>
                    <TextBlock x:Name="TxtCount" Text="" FontSize="12" Foreground="#8795A5" VerticalAlignment="Center" Margin="16,0,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Row="1" Style="{StaticResource Card}">
                <Border.Effect><DropShadowEffect ShadowDepth="2" BlurRadius="10" Opacity="0.06" Color="Black"/></Border.Effect>
                <DataGrid x:Name="DgStock" Style="{StaticResource DarkGrid}"
                          RowStyle="{StaticResource DarkRow}" CellStyle="{StaticResource DarkCell}">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F6F8FA"/>
                            <Setter Property="Foreground" Value="#8B0000"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontFamily" Value="Segoe UI"/>
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="BorderBrush" Value="#E0E4E8"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID"         Binding="{Binding Id}"             Width="45"/>
                        <DataGridTemplateColumn Header="QR Code" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <ToggleButton x:Name="QrButton" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                            <Image Width="50" Height="50" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" Source="{Binding Converter={StaticResource StockToQrConverter}}"/>
                                        </ToggleButton>
                                        <Popup IsOpen="{Binding IsChecked, ElementName=QrButton}" StaysOpen="False" Placement="Mouse" AllowsTransparency="True">
                                            <Border Background="White" BorderBrush="#8B0000" BorderThickness="3" CornerRadius="8" Padding="10">
                                                <Image Width="250" Height="250" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" Source="{Binding Converter={StaticResource StockToQrConverter}}"/>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Blood Type" Binding="{Binding BloodType}"      Width="100"/>
                        <DataGridTemplateColumn Header="Units" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding UnitsAvailable}" FontWeight="Bold"
                                               Foreground="{Binding StockLevelColor}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Source"   Binding="{Binding Source}"         Width="170"/>
                        <DataGridTextColumn Header="Received" Binding="{Binding ReceivedDate, StringFormat='yyyy-MM-dd'}" Width="110"/>
                        <DataGridTextColumn Header="Expiry"   Binding="{Binding ExpiryDisplay}"  Width="110"/>
                        <DataGridTemplateColumn Header="Warning" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ExpiryWarning}"
                                               Foreground="{Binding ExpiryWarningColor}"
                                               FontWeight="SemiBold" FontSize="12"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Status"   Binding="{Binding Status}"         Width="90"/>
                        <DataGridTemplateColumn Header="Actions" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="4,2">
                                        <Button Content="Edit"   Style="{StaticResource EditBtn}" Margin="0,0,5,0" Click="BtnEdit_Click" Tag="{Binding}"/>
                                        <Button Content="Delete" Style="{StaticResource DelBtn}"  Click="BtnDelete_Click" Tag="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
        <Grid x:Name="Overlay" Grid.RowSpan="2" Visibility="Collapsed" Background="#88000000">
            <Border Background="#FFFFFF" Width="440" CornerRadius="14" VerticalAlignment="Center" BorderBrush="#8B000030" BorderThickness="1">
                <Border.Effect><DropShadowEffect ShadowDepth="4" BlurRadius="20" Opacity="0.15" Color="Black"/></Border.Effect>
                <StackPanel Margin="32,26">
                    <TextBlock x:Name="FrmTitle" Text="Add Blood Stock" FontSize="18" FontWeight="Bold" FontFamily="Segoe UI Semibold" Foreground="#8B0000" Margin="0,0,0,18"/>
                    <TextBlock Text="BLOOD TYPE *" Style="{StaticResource FL}"/>
                    <ComboBox x:Name="FBlood" Style="{StaticResource FCB}">
                        <ComboBoxItem Content="A+"/><ComboBoxItem Content="A-"/><ComboBoxItem Content="B+"/><ComboBoxItem Content="B-"/>
                        <ComboBoxItem Content="AB+"/><ComboBoxItem Content="AB-"/><ComboBoxItem Content="O+"/><ComboBoxItem Content="O-"/>
                    </ComboBox>
                    <TextBlock Text="UNITS AVAILABLE *" Style="{StaticResource FL}"/>
                    <TextBox x:Name="FUnits" Style="{StaticResource FTB}"/>
                    <TextBlock Text="SOURCE (Donor name or event)" Style="{StaticResource FL}"/>
                    <TextBox x:Name="FSource" Style="{StaticResource FTB}"/>
                    <TextBlock Text="EXPIRY DATE" Style="{StaticResource FL}"/>
                    <DatePicker x:Name="FExpiry" Height="40" Margin="0,0,0,12" FontSize="13" Background="#FFFFFF" Foreground="#1A1A2E"/>
                    <TextBlock Text="STATUS *" Style="{StaticResource FL}"/>
                    <ComboBox x:Name="FStatus" Style="{StaticResource FCB}">
                        <ComboBoxItem Content="Available" IsSelected="True"/><ComboBoxItem Content="Used"/><ComboBoxItem Content="Expired"/>
                    </ComboBox>
                    <TextBlock x:Name="FError" Text="" Foreground="#8B0000" FontSize="12" Margin="0,0,0,8" Visibility="Collapsed"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="Cancel" Style="{StaticResource CancelBtn}" Margin="0,0,10,0" Click="BtnCancel_Click"/>
                        <Button Content="💾  Save" Style="{StaticResource PrimaryBtn}" Click="BtnSave_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

