<UserControl x:Class="BloodBankPro.Views.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded" Background="#F9F9F9">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#FFFFFF" Padding="24,16" BorderBrush="#E0E4E8" BorderThickness="0,0,0,1">
            <Border.Effect><DropShadowEffect ShadowDepth="1" BlurRadius="6" Opacity="0.04" Color="Black"/></Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{DynamicResource Page_UserMgmt}" Style="{StaticResource PageHeader}"/>
                    <TextBlock Text="Admin-only — manage system user accounts and roles" Style="{StaticResource PageSub}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="💾 Backup Database" Background="#8B0000" Foreground="White" BorderThickness="0" Padding="14,8" Margin="0,0,12,0" Click="BtnBackup_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="+ Add User" Style="{StaticResource PrimaryBtn}" Click="BtnAdd_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,12">
                <TextBlock x:Name="TxtCount" Text="" FontSize="12" Foreground="#8795A5" VerticalAlignment="Center"/>
            </Border>
            <Border Grid.Row="1" Style="{StaticResource Card}">
                <Border.Effect><DropShadowEffect ShadowDepth="2" BlurRadius="10" Opacity="0.06" Color="Black"/></Border.Effect>
                <DataGrid x:Name="DgUsers" Style="{StaticResource DarkGrid}"
                          RowStyle="{StaticResource DarkRow}" CellStyle="{StaticResource DarkCell}">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F6F8FA"/>
                            <Setter Property="Foreground" Value="#8B0000"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontFamily" Value="Segoe UI"/>
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="BorderBrush" Value="#E0E4E8"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID"         Binding="{Binding Id}"          Width="50"/>
                        <DataGridTextColumn Header="Username"   Binding="{Binding Username}"    Width="140"/>
                        <DataGridTextColumn Header="Full Name"  Binding="{Binding FullName}"    Width="180"/>
                        <DataGridTemplateColumn Header="Role" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="6,2" Margin="4,4" HorizontalAlignment="Left">
                                        <Border.Background><Binding Path="RoleColor"/></Border.Background>
                                        <TextBlock Text="{Binding Role}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Email"      Binding="{Binding Email}"          Width="200"/>
                        <DataGridTextColumn Header="Status"     Binding="{Binding StatusDisplay}"  Width="90"/>
                        <DataGridTextColumn Header="Created"    Binding="{Binding CreatedDate, StringFormat='yyyy-MM-dd'}" Width="110"/>
                        <DataGridTemplateColumn Header="Actions" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="4,2">
                                        <Button Content="Edit"   Style="{StaticResource EditBtn}" Margin="0,0,5,0" Click="BtnEdit_Click" Tag="{Binding}"/>
                                        <Button Content="Delete" Style="{StaticResource DelBtn}"  Click="BtnDelete_Click" Tag="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
        <Grid x:Name="Overlay" Grid.RowSpan="2" Visibility="Collapsed" Background="#88000000">
            <Border Background="#FFFFFF" Width="440" CornerRadius="14" VerticalAlignment="Center" BorderBrush="#8B000030" BorderThickness="1">
                <Border.Effect><DropShadowEffect ShadowDepth="4" BlurRadius="20" Opacity="0.15" Color="Black"/></Border.Effect>
                <StackPanel Margin="32,26">
                    <TextBlock x:Name="FrmTitle" Text="Add User" FontSize="18" FontWeight="Bold" FontFamily="Segoe UI Semibold" Foreground="#8B0000" Margin="0,0,0,18"/>
                    <TextBlock Text="USERNAME *" Style="{StaticResource FL}"/>
                    <TextBox x:Name="FUsername" Style="{StaticResource FTB}"/>
                    <TextBlock Text="PASSWORD *" Style="{StaticResource FL}"/>
                    <TextBox x:Name="FPassword" Style="{StaticResource FTB}"/>
                    <TextBlock Text="FULL NAME *" Style="{StaticResource FL}"/>
                    <TextBox x:Name="FFullName" Style="{StaticResource FTB}"/>
                    <TextBlock Text="EMAIL" Style="{StaticResource FL}"/>
                    <TextBox x:Name="FEmail" Style="{StaticResource FTB}"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="ROLE *" Style="{StaticResource FL}"/>
                            <ComboBox x:Name="FRole" Style="{StaticResource FCB}">
                                <ComboBoxItem Content="Staff" IsSelected="True"/>
                                <ComboBoxItem Content="Admin"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="STATUS" Style="{StaticResource FL}"/>
                            <ComboBox x:Name="FActive" Style="{StaticResource FCB}">
                                <ComboBoxItem Content="Active" IsSelected="True"/>
                                <ComboBoxItem Content="Inactive"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="FError" Text="" Foreground="#8B0000" FontSize="12" Margin="0,0,0,8" Visibility="Collapsed"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="Cancel" Style="{StaticResource CancelBtn}" Margin="0,0,10,0" Click="BtnCancel_Click"/>
                        <Button Content="💾  Save User" Style="{StaticResource PrimaryBtn}" Click="BtnSave_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

