<UserControl x:Class="BloodBankPro.Views.AppointmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded" Background="#F9F9F9">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#FFFFFF" Padding="24,16" BorderBrush="#E0E4E8" BorderThickness="0,0,0,1">
            <Border.Effect><DropShadowEffect ShadowDepth="1" BlurRadius="6" Opacity="0.04" Color="Black"/></Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{DynamicResource Page_Appointments}" Style="{StaticResource PageHeader}"/>
                    <TextBlock Text="Schedule and track donor appointments and health check-ups" Style="{StaticResource PageSub}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="+ Schedule Appointment" Style="{StaticResource PrimaryBtn}" Background="#E65100" Click="BtnAdd_Click"/>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,12">
                <Border.Effect><DropShadowEffect ShadowDepth="1" BlurRadius="6" Opacity="0.04" Color="Black"/></Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <ComboBox x:Name="CmbStatus" Style="{StaticResource FCB}" Height="34" Width="140" Margin="0,0,10,0" SelectionChanged="OnFilter">
                        <ComboBoxItem Content="All Status" IsSelected="True"/>
                        <ComboBoxItem Content="Scheduled"/><ComboBoxItem Content="Completed"/>
                        <ComboBoxItem Content="Cancelled"/><ComboBoxItem Content="NoShow"/>
                    </ComboBox>
                    <DatePicker x:Name="DpFilter" Height="34" Width="150" FontSize="13" Margin="0,0,10,0"
                                Background="#FFFFFF" Foreground="#1A1A2E" SelectedDateChanged="OnFilter"/>
                    <Button Content="Clear Date Filter" Style="{StaticResource IconBtn}" Click="BtnClearDate_Click"/>
                    <TextBlock x:Name="TxtCount" Text="" FontSize="12" Foreground="#8795A5" VerticalAlignment="Center" Margin="16,0,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Row="1" Style="{StaticResource Card}">
                <Border.Effect><DropShadowEffect ShadowDepth="2" BlurRadius="10" Opacity="0.06" Color="Black"/></Border.Effect>
                <DataGrid x:Name="DgAppts" Style="{StaticResource DarkGrid}"
                          RowStyle="{StaticResource DarkRow}" CellStyle="{StaticResource DarkCell}">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F6F8FA"/>
                            <Setter Property="Foreground" Value="#E65100"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontFamily" Value="Segoe UI"/>
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="BorderBrush" Value="#E0E4E8"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID"         Binding="{Binding Id}"              Width="45"/>
                        <DataGridTextColumn Header="Donor"      Binding="{Binding DonorName}"       Width="180"/>
                        <DataGridTextColumn Header="Blood Type" Binding="{Binding BloodType}"       Width="95"/>
                        <DataGridTextColumn Header="Date"       Binding="{Binding DateDisplay}"     Width="110"/>
                        <DataGridTextColumn Header="Time"       Binding="{Binding AppointmentTime}" Width="80"/>
                        <DataGridTextColumn Header="Purpose"    Binding="{Binding Purpose}"         Width="110"/>
                        <DataGridTemplateColumn Header="Status" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Status}" FontWeight="SemiBold" FontSize="12"
                                               Foreground="{Binding StatusColor}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Notes"      Binding="{Binding Notes}"           Width="*"/>
                        <DataGridTemplateColumn Header="Actions" Width="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="4,2">
                                        <Button Content="✅ Done" Style="{StaticResource FulfillBtn}" Margin="0,0,5,0" Click="BtnComplete_Click" Tag="{Binding}"/>
                                        <Button Content="Edit"    Style="{StaticResource EditBtn}"   Margin="0,0,5,0" Click="BtnEdit_Click" Tag="{Binding}"/>
                                        <Button Content="Delete"  Style="{StaticResource DelBtn}"   Click="BtnDelete_Click" Tag="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
        <Grid x:Name="Overlay" Grid.RowSpan="2" Visibility="Collapsed" Background="#88000000">
            <Border Background="#FFFFFF" Width="470" CornerRadius="14" VerticalAlignment="Center" BorderBrush="#E6510030" BorderThickness="1">
                <Border.Effect><DropShadowEffect ShadowDepth="4" BlurRadius="20" Opacity="0.15" Color="Black"/></Border.Effect>
                <StackPanel Margin="32,26">
                    <TextBlock x:Name="FrmTitle" Text="Schedule Appointment" FontSize="18" FontWeight="Bold" FontFamily="Segoe UI Semibold" Foreground="#E65100" Margin="0,0,0,18"/>
                    <TextBlock Text="DONOR *" Style="{StaticResource FL}"/>
                    <ComboBox x:Name="FDonor" Style="{StaticResource FCB}" DisplayMemberPath="FullName" SelectedValuePath="Id"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="DATE *" Style="{StaticResource FL}"/>
                            <DatePicker x:Name="FDate" Height="40" Margin="0,0,0,12" FontSize="13" Background="#FFFFFF" Foreground="#1A1A2E"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="TIME *" Style="{StaticResource FL}"/>
                            <ComboBox x:Name="FTime" Style="{StaticResource FCB}">
                                <ComboBoxItem Content="08:00"/><ComboBoxItem Content="08:30"/>
                                <ComboBoxItem Content="09:00" IsSelected="True"/><ComboBoxItem Content="09:30"/>
                                <ComboBoxItem Content="10:00"/><ComboBoxItem Content="10:30"/>
                                <ComboBoxItem Content="11:00"/><ComboBoxItem Content="11:30"/>
                                <ComboBoxItem Content="12:00"/><ComboBoxItem Content="13:00"/>
                                <ComboBoxItem Content="13:30"/><ComboBoxItem Content="14:00"/>
                                <ComboBoxItem Content="14:30"/><ComboBoxItem Content="15:00"/>
                                <ComboBoxItem Content="15:30"/><ComboBoxItem Content="16:00"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="PURPOSE *" Style="{StaticResource FL}"/>
                            <ComboBox x:Name="FPurpose" Style="{StaticResource FCB}">
                                <ComboBoxItem Content="Donation" IsSelected="True"/>
                                <ComboBoxItem Content="CheckUp"/>
                                <ComboBoxItem Content="Consultation"/>
                                <ComboBoxItem Content="Other"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="STATUS" Style="{StaticResource FL}"/>
                            <ComboBox x:Name="FStatus" Style="{StaticResource FCB}">
                                <ComboBoxItem Content="Scheduled" IsSelected="True"/>
                                <ComboBoxItem Content="Completed"/>
                                <ComboBoxItem Content="Cancelled"/>
                                <ComboBoxItem Content="NoShow"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="NOTES" Style="{StaticResource FL}"/>
                    <TextBox x:Name="FNotes" Style="{StaticResource FTB}" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
                    <TextBlock x:Name="FError" Text="" Foreground="#8B0000" FontSize="12" Margin="0,0,0,8" Visibility="Collapsed"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="Cancel" Style="{StaticResource CancelBtn}" Margin="0,0,10,0" Click="BtnCancel_Click"/>
                        <Button Content="💾  Save" Style="{StaticResource PrimaryBtn}" Background="#E65100" Click="BtnSave_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

