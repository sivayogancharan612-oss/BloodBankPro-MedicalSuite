<UserControl x:Class="BloodBankPro.Views.HospitalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded" Background="#F9F9F9">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#FFFFFF" Padding="24,16" BorderBrush="#E0E4E8" BorderThickness="0,0,0,1">
            <Border.Effect><DropShadowEffect ShadowDepth="1" BlurRadius="6" Opacity="0.04" Color="Black"/></Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{DynamicResource Page_Hospitals}" Style="{StaticResource PageHeader}"/>
                    <TextBlock Text="Registered hospitals and clinics that request blood" Style="{StaticResource PageSub}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="📤 Export" Style="{StaticResource IconBtn}" Margin="0,0,8,0" Click="BtnExport_Click"/>
                    <Button Content="+ Add Hospital" Style="{StaticResource PrimaryBtn}" Click="BtnAdd_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,12">
                <Border.Effect><DropShadowEffect ShadowDepth="1" BlurRadius="6" Opacity="0.04" Color="Black"/></Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔍" FontSize="14" Foreground="#5A6A7A" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="TxtSearch" Height="34" Width="300" Padding="8,6" FontSize="13"
                             Background="#FFFFFF" Foreground="#1A1A2E" BorderBrush="#D5D8DC" BorderThickness="1"
                             CaretBrush="#8B0000" TextChanged="OnSearch"/>
                    <TextBlock x:Name="TxtCount" Text="" FontSize="12" Foreground="#8795A5" VerticalAlignment="Center" Margin="16,0,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Row="1" Style="{StaticResource Card}">
                <Border.Effect><DropShadowEffect ShadowDepth="2" BlurRadius="10" Opacity="0.06" Color="Black"/></Border.Effect>
                <DataGrid x:Name="DgHospitals" Style="{StaticResource DarkGrid}"
                          RowStyle="{StaticResource DarkRow}" CellStyle="{StaticResource DarkCell}">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F6F8FA"/>
                            <Setter Property="Foreground" Value="#00838F"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontFamily" Value="Segoe UI"/>
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="BorderBrush" Value="#E0E4E8"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID"            Binding="{Binding Id}"            Width="45"/>
                        <DataGridTextColumn Header="Hospital Name" Binding="{Binding Name}"          Width="200"/>
                        <DataGridTextColumn Header="Contact"       Binding="{Binding ContactPerson}" Width="140"/>
                        <DataGridTextColumn Header="Phone"         Binding="{Binding Phone}"         Width="120"/>
                        <DataGridTextColumn Header="City"          Binding="{Binding City}"          Width="100"/>
                        <DataGridTextColumn Header="Address"       Binding="{Binding Address}"       Width="*"/>
                        <DataGridTemplateColumn Header="Actions" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="4,2">
                                        <Button Content="Edit"   Style="{StaticResource EditBtn}" Margin="0,0,5,0" Click="BtnEdit_Click" Tag="{Binding}"/>
                                        <Button Content="Delete" Style="{StaticResource DelBtn}"  Click="BtnDelete_Click" Tag="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
        <Grid x:Name="Overlay" Grid.RowSpan="2" Visibility="Collapsed" Background="#88000000">
            <Border Background="#FFFFFF" Width="460" CornerRadius="14" VerticalAlignment="Center" BorderBrush="#00838F30" BorderThickness="1">
                <Border.Effect><DropShadowEffect ShadowDepth="4" BlurRadius="20" Opacity="0.15" Color="Black"/></Border.Effect>
                <StackPanel Margin="32,26">
                    <TextBlock x:Name="FrmTitle" Text="Add Hospital" FontSize="18" FontWeight="Bold" FontFamily="Segoe UI Semibold" Foreground="#00838F" Margin="0,0,0,18"/>
                    <TextBlock Text="HOSPITAL NAME *" Style="{StaticResource FL}"/>
                    <TextBox x:Name="FName" Style="{StaticResource FTB}"/>
                    <TextBlock Text="CONTACT PERSON" Style="{StaticResource FL}"/>
                    <TextBox x:Name="FContact" Style="{StaticResource FTB}"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="PHONE" Style="{StaticResource FL}"/>
                            <TextBox x:Name="FPhone" Style="{StaticResource FTB}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="CITY" Style="{StaticResource FL}"/>
                            <TextBox x:Name="FCity" Style="{StaticResource FTB}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="EMAIL" Style="{StaticResource FL}"/>
                    <TextBox x:Name="FEmail" Style="{StaticResource FTB}"/>
                    <TextBlock Text="ADDRESS" Style="{StaticResource FL}"/>
                    <TextBox x:Name="FAddress" Style="{StaticResource FTB}"/>
                    <TextBlock x:Name="FError" Text="" Foreground="#8B0000" FontSize="12" Margin="0,0,0,8" Visibility="Collapsed"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="Cancel" Style="{StaticResource CancelBtn}" Margin="0,0,10,0" Click="BtnCancel_Click"/>
                        <Button Content="💾  Save Hospital" Style="{StaticResource PrimaryBtn}" Background="#00838F" Click="BtnSave_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

