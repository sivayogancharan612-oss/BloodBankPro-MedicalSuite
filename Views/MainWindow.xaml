<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="BloodBankPro.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BloodBank"
        Height="760" Width="1260"
        WindowStartupLocation="CenterScreen"
        MinHeight="660" MinWidth="1060"
        Background="#F9F9F9">

    <Window.Resources>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#5A6A80"/>
            <Setter Property="Margin" Value="22,14,0,6"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#1A1A2E">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="2" BlurRadius="12" Opacity="0.08" Color="Black" Direction="0"/>
            </Border.Effect>
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="#1A1A2E"
                        BorderBrush="#2A2A42" BorderThickness="0,0,0,1" Padding="18,18,18,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Background="#2A2F4F" Width="40" Height="40" CornerRadius="8"
                                    BorderBrush="#DC143C" BorderThickness="1.5" Margin="0,0,10,0">
                                <Image Source="/Resources/bloodbank_logo.png" Stretch="Uniform" Margin="4"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="BloodBank" FontSize="15" FontWeight="Bold"
                                           FontFamily="Segoe UI Semibold" Foreground="#ECEFF1"/>
                                <TextBlock Text="{DynamicResource App_Subtitle}" FontSize="10" 
                                           FontFamily="Segoe UI" Foreground="#5A6A80"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Background="#2A2A42" CornerRadius="8" Padding="10,8"
                                BorderBrush="#3A3A52" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="TxtUserName" Text="" FontSize="12"
                                               FontWeight="SemiBold" Foreground="#ECEFF1"/>
                                    <TextBlock x:Name="TxtUserRole" Text="" FontSize="10" Foreground="#5A6A80"/>
                                </StackPanel>
                                <Ellipse Grid.Column="1" Width="8" Height="8" Fill="#2E7D32" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
                <Border DockPanel.Dock="Bottom" Padding="8,8"
                        BorderBrush="#2A2A42" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <ComboBox x:Name="CmbLanguage" Margin="10,0,10,6" Height="32"
                                  Background="#2A2A42" BorderBrush="#3A3A52" BorderThickness="1"
                                  FontSize="12" FontFamily="Segoe UI"
                                  Foreground="#2F4F4F"
                                  SelectionChanged="OnLanguageChanged">
                            <ComboBox.Resources>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Foreground" Value="#2F4F4F"/>
                                    <Setter Property="FontFamily" Value="Segoe UI"/>
                                    <Setter Property="FontSize" Value="12"/>
                                </Style>
                            </ComboBox.Resources>
                            <ComboBoxItem Content="English" Tag="en" IsSelected="True"/>
                            <ComboBoxItem Content="සිංහල" Tag="si"/>
                            <ComboBoxItem Content="தமிழ்" Tag="ta"/>
                        </ComboBox>
                        <Button Content="{DynamicResource Nav_SignOut}" Style="{StaticResource NavBtn}"
                                Foreground="#FF6B6B" Click="BtnLogout_Click"/>
                    </StackPanel>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Text="{DynamicResource Nav_Section_Main}" Style="{StaticResource SectionLabel}"/>
                        <Button x:Name="Btn0" Content="{DynamicResource Nav_Dashboard}"     Tag="0" Style="{StaticResource NavBtnOn}" Click="Nav_Click"/>
                        <Button x:Name="Btn1" Content="{DynamicResource Nav_Donors}"        Tag="1" Style="{StaticResource NavBtn}"   Click="Nav_Click"/>
                        <Button x:Name="Btn2" Content="{DynamicResource Nav_BloodStock}"    Tag="2" Style="{StaticResource NavBtn}"   Click="Nav_Click"/>
                        <Button x:Name="Btn3" Content="{DynamicResource Nav_Hospitals}"     Tag="3" Style="{StaticResource NavBtn}"   Click="Nav_Click"/>

                        <TextBlock Text="{DynamicResource Nav_Section_Operations}" Style="{StaticResource SectionLabel}"/>
                        <Button x:Name="Btn4" Content="{DynamicResource Nav_BloodRequests}" Tag="4" Style="{StaticResource NavBtn}"   Click="Nav_Click"/>
                        <Button x:Name="Btn5" Content="{DynamicResource Nav_Donations}"     Tag="5" Style="{StaticResource NavBtn}"   Click="Nav_Click"/>
                        <Button x:Name="Btn6" Content="{DynamicResource Nav_Appointments}"  Tag="6" Style="{StaticResource NavBtn}"   Click="Nav_Click"/>

                        <TextBlock Text="{DynamicResource Nav_Section_Analysis}" Style="{StaticResource SectionLabel}"/>
                        <Button x:Name="Btn7" Content="{DynamicResource Nav_Compatibility}" Tag="7" Style="{StaticResource NavBtn}"   Click="Nav_Click"/>
                        <Button x:Name="Btn8" Content="{DynamicResource Nav_Reports}"       Tag="8" Style="{StaticResource NavBtn}"   Click="Nav_Click"/>

                        <TextBlock Text="{DynamicResource Nav_Section_System}" Style="{StaticResource SectionLabel}"/>
                        <Button x:Name="Btn9"  Content="{DynamicResource Nav_UserMgmt}"     Tag="9"  Style="{StaticResource NavBtn}"  Click="Nav_Click"/>
                        <Button x:Name="Btn10" Content="{DynamicResource Nav_AuditLog}"     Tag="10" Style="{StaticResource NavBtn}"  Click="Nav_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
        <Border Grid.Column="1" Background="#F9F9F9"
                BorderBrush="#E0E4E8" BorderThickness="1,0,0,0">
            <ContentControl x:Name="ContentArea"/>
        </Border>
    </Grid>
</Window>

