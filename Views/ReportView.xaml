<UserControl x:Class="BloodBankPro.Views.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded" Background="#F9F9F9">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#FFFFFF" Padding="24,16" BorderBrush="#E0E4E8" BorderThickness="0,0,0,1">
            <Border.Effect><DropShadowEffect ShadowDepth="1" BlurRadius="6" Opacity="0.04" Color="Black"/></Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{DynamicResource Page_Reports}" Style="{StaticResource PageHeader}"/>
                    <TextBlock Text="Blood type statistics — donations, stock levels, fulfillment rates" Style="{StaticResource PageSub}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="📤 Export Report" Style="{StaticResource IconBtn}" Click="BtnExport_Click"/>
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20">
                <TextBlock Text="📊  Blood Type Summary" FontSize="14" FontWeight="Bold" FontFamily="Segoe UI Semibold" Foreground="#1A1A2E" Margin="0,0,0,12"/>
                <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                    <Border.Effect><DropShadowEffect ShadowDepth="2" BlurRadius="10" Opacity="0.06" Color="Black"/></Border.Effect>
                    <DataGrid x:Name="DgReport" Style="{StaticResource DarkGrid}"
                              RowStyle="{StaticResource DarkRow}" CellStyle="{StaticResource DarkCell}">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F6F8FA"/>
                                <Setter Property="Foreground" Value="#1A1A2E"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontFamily" Value="Segoe UI"/>
                                <Setter Property="Padding" Value="14,0"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="BorderBrush" Value="#E0E4E8"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Blood Type"       Binding="{Binding BloodType}"         Width="120"/>
                            <DataGridTextColumn Header="Active Donors"    Binding="{Binding ActiveDonors}"      Width="130"/>
                            <DataGridTextColumn Header="Total Donations"  Binding="{Binding TotalDonations}"    Width="140"/>
                            <DataGridTemplateColumn Header="Units in Stock" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding UnitsInStock}" FontWeight="Bold"
                                                   Foreground="{Binding StockColor}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Total Requests"   Binding="{Binding TotalRequests}"     Width="130"/>
                            <DataGridTextColumn Header="Fulfilled"        Binding="{Binding FulfilledRequests}" Width="110"/>
                            <DataGridTemplateColumn Header="Fulfillment Rate" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="14,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#F0F2F5" CornerRadius="99" Height="10" VerticalAlignment="Center">
                                                <Border Background="{Binding FulfillRateColor}" CornerRadius="99"
                                                        Height="10" HorizontalAlignment="Left"
                                                        Width="{Binding RateBarWidth}"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding FulfillRateText}"
                                                       FontSize="12" FontWeight="Bold"
                                                       Foreground="{Binding FulfillRateColor}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
                <TextBlock Text="🩸  Stock Level Visualizer" FontSize="14" FontWeight="Bold" FontFamily="Segoe UI Semibold" Foreground="#1A1A2E" Margin="0,0,0,12"/>
                <Border Style="{StaticResource Card}" Padding="24,20">
                    <Border.Effect><DropShadowEffect ShadowDepth="2" BlurRadius="10" Opacity="0.06" Color="Black"/></Border.Effect>
                    <ItemsControl x:Name="StockBars">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding BloodType}" FontWeight="Bold"
                                               FontSize="15" Foreground="{Binding StockColor}" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Background="#E5E9ED" CornerRadius="2" Height="4" Margin="12,0" VerticalAlignment="Center">
                                        <Border Background="{Binding StockColor}" CornerRadius="2"
                                                Height="4" HorizontalAlignment="Left" Width="{Binding BarWidth}"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" FontWeight="Bold" FontSize="13"
                                               Foreground="{Binding StockColor}" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <Run Text="{Binding UnitsInStock, Mode=OneWay}"/>
                                        <Run Text=" units" Foreground="#8795A5"/>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

