<UserControl x:Class="BloodBankPro.Views.AuditLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded" Background="#F9F9F9">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#FFFFFF" Padding="24,16" BorderBrush="#E0E4E8" BorderThickness="0,0,0,1">
            <Border.Effect><DropShadowEffect ShadowDepth="1" BlurRadius="6" Opacity="0.04" Color="Black"/></Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{DynamicResource Page_AuditLog}" Style="{StaticResource PageHeader}"/>
                    <TextBlock Text="Full history of every INSERT, UPDATE, DELETE and FULFILL action in the system" Style="{StaticResource PageSub}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="📤 Export" Style="{StaticResource IconBtn}" Margin="0,0,8,0" Click="BtnExport_Click"/>
                    <Button Content="🔄 Refresh" Style="{StaticResource IconBtn}" Click="BtnRefresh_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,12">
                <Border.Effect><DropShadowEffect ShadowDepth="1" BlurRadius="6" Opacity="0.04" Color="Black"/></Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔍" FontSize="14" Foreground="#5A6A7A" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="TxtSearch" Height="34" Width="280" Padding="8,6" FontSize="13"
                             Background="#FFFFFF" Foreground="#1A1A2E" BorderBrush="#D5D8DC" BorderThickness="1"
                             CaretBrush="#8B0000" Margin="0,0,10,0" TextChanged="OnSearch"/>
                    <TextBlock x:Name="TxtCount" Text="" FontSize="12" Foreground="#8795A5"
                               VerticalAlignment="Center" Margin="0,0,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Row="1" Style="{StaticResource Card}">
                <Border.Effect><DropShadowEffect ShadowDepth="2" BlurRadius="10" Opacity="0.06" Color="Black"/></Border.Effect>
                <DataGrid x:Name="DgLogs" Style="{StaticResource DarkGrid}"
                          RowStyle="{StaticResource DarkRow}" CellStyle="{StaticResource DarkCell}">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F6F8FA"/>
                            <Setter Property="Foreground" Value="#5A6A7A"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontFamily" Value="Segoe UI"/>
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="BorderBrush" Value="#E0E4E8"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID"        Binding="{Binding Id}"             Width="55"/>
                        <DataGridTemplateColumn Header="Action" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="6,2" Margin="4,5" HorizontalAlignment="Left">
                                        <Border.Background><Binding Path="ActionColor"/></Border.Background>
                                        <TextBlock Text="{Binding Action}" Foreground="White"
                                                   FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Module"    Binding="{Binding TableName}"      Width="130"/>
                        <DataGridTextColumn Header="Details"   Binding="{Binding Details}"        Width="*"/>
                        <DataGridTextColumn Header="User"      Binding="{Binding Username}"       Width="110"/>
                        <DataGridTextColumn Header="Timestamp" Binding="{Binding LogDateDisplay}" Width="160"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

